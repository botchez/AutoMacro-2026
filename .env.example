NUTRICOACH_DB_PATH=data/nutricoach.sqlite3
NUTRICOACH_FRONTEND_DIST=dist

# One key drives both model stages (vision cascade + coach agent) via OpenRouter.
# Without it, vision falls back to a deterministic filename match; the coach has no
# fallback and returns HTTP 502.
OPENROUTER_API_KEY=

# Coach agent kill switch. On by default; set to 0 to switch the coach's model calls
# off without touching vision (it then returns 502 rather than faking a reply).
COACH_AGENT_ENABLED=1

# Model slugs (OpenRouter). The vision PRIMARY must be multimodal; the coach model
# must support tool calling. Override here to try others.
VISION_MODEL=google/gemma-4-31b-it
COACH_MODEL=deepseek/deepseek-v4-flash

# Optional fallbacks used when the primary errors out.
# VISION_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# COACH_FALLBACK_MODEL=openai/gpt-4o-mini

# Vision tuning. Reasoning is ON by default (helps label-OCR digits and
# packaged-vs-label routing); set to 0 for ~2x faster responses.
# VISION_REASONING=1
# VISION_REASONING_MAX_TOKENS=1024   (thinking budget)
# VISION_MAX_TOKENS=2500             (overall completion ceiling)
# VISION_MAX_EDGE=1024               (downscale for the model call only)

# USDA FoodData Central enrichment for generic ingredients. Either name works
# (FDC_API_KEY is what the vendored lookup reads; config bridges USDA_FDC_API_KEY).
# DEMO_KEY is rate-limited hard — set a real key before a live demo.
USDA_FDC_API_KEY=
FDC_API_KEY=

# Open Food Facts wants a compliant "AppName/Version (contact)" UA on its read
# endpoints. Read-only ops need nothing else — no account, no login. Put your own
# contact here if you fork this.
OFF_USER_AGENT=nutricoach/1.0 (you@example.com)

# Optional: write a full human-readable transcript per vision/coach run to this
# directory — model reasoning, raw JSON, tool calls, and each component's macro
# source. This is the only place the vision reasoning is exposed.
# NUTRICOACH_TRANSCRIPTS=data/transcripts

# Legacy / unused by the model stages now; kept for backward compatibility.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
